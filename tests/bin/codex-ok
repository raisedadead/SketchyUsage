#!/bin/sh
fixture="$(cd "$(dirname "$0")/.." && pwd)/fixtures/codex-ratelimits.json"
while IFS= read -r line; do
  case "$line" in
    '{"id":1,'*) printf '%s\n' 'not json' '{"id":1,"result":{"userAgent":"fake"}}' ;;
    '{"id":2,'*) printf '{"id":2,"result":%s}\n' "$(cat "$fixture")" ;;
  esac
done
